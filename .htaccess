# Three Vistas: 301 redirects from the old WordPress site
Options -MultiViews
RewriteEngine On
# Force https and the bare domain
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://threevistas.com/$1 [R=301,L]

# Exact URLs (trailing slash optional, case-insensitive)
RewriteRule ^about/?$ /about.html [R=301,L,NC]
RewriteRule ^contact/?$ /contact.html [R=301,L,NC]
RewriteRule ^testimonials/?$ /about.html [R=301,L,NC]
